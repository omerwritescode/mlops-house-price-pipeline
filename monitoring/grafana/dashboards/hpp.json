{
 "uid": "hpp-main",
 "title": "House price model - serving & monitoring",
 "tags": [
  "mlops",
  "hpp"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Serving - live operational metrics (API /metrics)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Model in production",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (model_version, git_commit, image_tag) (hpp_model_info)",
     "legendFormat": "v{{model_version}} \u00b7 {{git_commit}} \u00b7 {{image_tag}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "name",
    "colorMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Throughput (req/s)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(hpp_http_requests_total{endpoint=~\"/predict.*\"}[1m]))",
     "legendFormat": "req/s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "title": "Error rate (5xx, /predict)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(hpp_http_requests_total{endpoint=~\"/predict.*\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(hpp_http_requests_total{endpoint=~\"/predict.*\"}[5m])),1e-9)",
     "legendFormat": "errors",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value"
   }
  },
  {
   "id": 5,
   "title": "p95 latency /predict",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hpp_http_request_duration_seconds_bucket{endpoint=\"/predict\"}[5m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value"
   }
  },
  {
   "id": 6,
   "title": "Requests by status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(hpp_http_requests_total{endpoint=~\"/predict.*\"}[1m]))",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Latency /predict (p50 / p95 / p99)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(hpp_http_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hpp_http_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(hpp_http_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Distribution of predicted prices (lakhs)",
   "type": "heatmap",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (le) (increase(hpp_predicted_price_lakhs_bucket[1m]))",
     "legendFormat": "{{le}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "format": "heatmap"
    }
   ],
   "options": {
    "calculate": false,
    "yAxis": {
     "unit": "none"
    },
    "color": {
     "mode": "scheme",
     "scheme": "Blues",
     "steps": 64
    },
    "cellGap": 2
   }
  },
  {
   "id": 9,
   "title": "Mean predicted price (lakhs)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(hpp_predicted_price_lakhs_sum[5m])) / clamp_min(sum(rate(hpp_predicted_price_lakhs_count[5m])),1e-9)",
     "legendFormat": "mean predicted price",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     },
     "custom": {
      "lineWidth": 2
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "row",
   "title": "Model quality - incoming batches (pushed by `hpp monitor`)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 11,
   "title": "Alert level per batch",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (batch) (hpp_batch_alert_level)",
     "legendFormat": "batch {{batch}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "\u25cf OK",
         "color": "#0ca30c"
        },
        "1": {
         "text": "\u25b2 WARNING",
         "color": "#fab219"
        },
        "2": {
         "text": "\u25b2 CRITICAL",
         "color": "#d03b3b"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 12,
   "title": "Batch RMSE / holdout RMSE",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 22,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (batch) (hpp_batch_rmse_ratio)",
     "legendFormat": "batch {{batch}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2,
     "min": 0,
     "max": 2.5,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 1.15
       },
       {
        "color": "#d03b3b",
        "value": 1.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic"
   }
  },
  {
   "id": 13,
   "title": "Batch bias (actual - predicted, lakhs)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (batch) (hpp_batch_bias_lakhs)",
     "legendFormat": "batch {{batch}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic"
   }
  },
  {
   "id": 14,
   "title": "Feature drift - PSI by batch",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (batch, feature) (hpp_batch_feature_psi)",
     "legendFormat": "b{{batch}} \u00b7 {{feature}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 3,
     "min": 0,
     "max": 0.4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#86b6ef",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 0.1
       },
       {
        "color": "#d03b3b",
        "value": 0.2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "minVizHeight": 10
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}